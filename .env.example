# Firebase 웹 앱 설정 (Firebase 콘솔 → 프로젝트 설정 → 내 앱 → SDK 설정에서 복사)
# 값이 비어 있으면 앱은 "로컬 전용 모드"로 동작한다. 게임은 되지만 랭킹은 없다.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# 교사 모드(/teacher) PIN 6자리. 코드에 하드코딩하지 않는다 (PRD 5.5).
VITE_TEACHER_PIN=
